+/// x86_64 version of the counting loop above. LLVM extracts bytes with
+/// shift-and-mask (17 ALU uops per word), and on Broadwell the loop is
+/// issue-bound. `al`/`ah` plus `shr rax, 16` needs 11. A per-word loop also
+/// measured faster than 32-byte unrolling
+/// (docs/performance/entropy-sla/probes/s5-x86-probes.log).
+#[cfg(target_arch = "x86_64")]
+#[inline(always)]
+fn count_banks<'a>(batch: &'a [u8], counters: &mut [[u16; 256]; 4]) -> &'a [u8] {
+    let base = counters.as_mut_ptr().cast::<u16>();
+    let (words, remainder) = batch.as_chunks::<8>();
+    for word in words {
+        // SAFETY: reads exactly the 8 bytes of `word`. Lane k (little-endian)
+        // increments counters[k & 3][byte], at byte offset 512 * (k & 3) + 2 * byte,
+        // which is below the 2048-byte size of `counters`. A batch holds at most
+        // 32768 bytes, so no u16 counter can wrap. `inc` changes only flags,
+        // the clobbered scratch registers and that memory.
+        unsafe {
+            std::arch::asm!(
+                "mov rax, qword ptr [{src}]",
+                "movzx ecx, al", "movzx edx, ah", "shr rax, 16",
+                "movzx esi, al", "movzx edi, ah", "shr rax, 16",
+                "inc word ptr [{base} + rcx*2]",
+                "inc word ptr [{base} + rdx*2 + 512]",
+                "inc word ptr [{base} + rsi*2 + 1024]",
+                "inc word ptr [{base} + rdi*2 + 1536]",
+                "movzx ecx, al", "movzx edx, ah", "shr rax, 16",
+                "movzx esi, al", "movzx edi, ah",
+                "inc word ptr [{base} + rcx*2]",
+                "inc word ptr [{base} + rdx*2 + 512]",
+                "inc word ptr [{base} + rsi*2 + 1024]",
+                "inc word ptr [{base} + rdi*2 + 1536]",
+                src = in(reg) word.as_ptr(), base = in(reg) base,
+                out("rax") _, out("rcx") _, out("rdx") _, out("rsi") _, out("rdi") _,
+                options(nostack),
+            );
+        }
+    }
+    remainder
+}
